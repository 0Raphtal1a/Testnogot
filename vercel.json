{
  "outputDirectory": "public",
  "functions": {
    "api/pins.js": {
      "maxDuration": 20
    },
    "api/img.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}